{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--group",
        "docs",
        "mkdocs",
        "serve",
        "-a",
        "127.0.0.1:8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "trialwatch",
        "web",
        "--reload"
      ],
      "port": 8010
    },
    {
      "name": "web-8020",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "trialwatch",
        "web",
        "--port",
        "8020",
        "--no-worker"
      ],
      "port": 8020
    }
  ]
}