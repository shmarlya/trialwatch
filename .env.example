# Copy to .env and change the password
POSTGRES_USER=trialwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trialwatch
# Host port for connecting a DB client (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
# The model's API key, for checks and AI tags. Empty: no model calls
ANTHROPIC_API_KEY=
# Which published image to run (ghcr.io/shmarlya/trialwatch): latest, or sha-<commit> to pin or roll back
TRIALWATCH_TAG=latest
# The first admin of the web interface: added when `trialwatch web` starts if no user has this
# email yet (an existing user is never changed). Password: at least 12 characters. Leave both empty
# to add users with `trialwatch user add` instead.
TRIALWATCH_ADMIN_EMAIL=
TRIALWATCH_ADMIN_PASSWORD=
# On a server (`docker compose --profile server up -d`): the site's public name, which caddy gets an HTTPS
# certificate for; its DNS must point at this machine. Empty: localhost, with a certificate of caddy's own.
TRIALWATCH_DOMAIN=
# Whose places patient search knows (`trialwatch geo load`), ISO codes, comma-separated; empty: the EU/EEA
TRIALWATCH_COUNTRIES=
# The ports caddy listens on (80 and 443 unless something else uses them)
HTTP_PORT=80
HTTPS_PORT=443
# Where the web server and the worker send traces, metrics and logs (docs/operations.md): on a server,
# compose's Grafana, http://lgtm:4318. Empty: nowhere (logs still go to stderr).
OTEL_EXPORTER_OTLP_ENDPOINT=
# The password of grafana_ro, the database role Grafana's dashboards read with (the report views only)
GRAFANA_DB_PASSWORD=
# Grafana's own address, when it isn't https://TRIALWATCH_DOMAIN/grafana/ (another port, say)
GRAFANA_ROOT_URL=
# How many days of nightly backups ./data/backups keeps
BACKUP_KEEP_DAYS=14
