# Copy to .env and change the password
POSTGRES_USER=trialwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trialwatch
# Host port for connecting a DB client (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
# The first admin of the web interface: added when `trialwatch web` starts if no user has this
# email yet (an existing user is never changed). Password: at least 12 characters. Leave both empty
# to add users with `trialwatch user add` instead.
TRIALWATCH_ADMIN_EMAIL=
TRIALWATCH_ADMIN_PASSWORD=
