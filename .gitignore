.venv/
__pycache__/
# Docs site built by `mkdocs build`
site/
.DS_Store
# Local research files, except the four Bruckner et al. files our code reads (published with the
# authors' permission, see data/bruckner/README.md) and the gold datasets built from them.
data/*
!data/bruckner/
# Gold datasets (ADR-003): versioned, locked in data/gold/versions.lock
!data/gold/
.env
