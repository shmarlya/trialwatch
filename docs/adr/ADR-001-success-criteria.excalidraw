   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 699072202,
   "version": 1,
   "versionNonce": 1646461875,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2\u20133 real options; the current proposal is only one of them",
   "originalText": "2\u20133 real options; the current proposal is only one of them",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "adr-optA",
   "type": "rectangle",
   "x": 40,
   "y": 448,
   "width": 480,
   "height": 336.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 62652715,
   "version": 1,
   "versionNonce": 336008050,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "adr-optA-text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "adr-optA-text",
   "type": "text",
   "x": 45,
   "y": 453,
   "width": 433.0,
   "height": 320.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1641634215,
   "version": 1,
   "versionNonce": 513186262,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A. Match the reviewers, then publish at \u2265 99% confidence\n(chosen)\n\nHow it works: run the workflow on the 2025-11-10 snapshot\nuntil every disagreement with the reviewers is explained. Each\nverdict carries an internal confidence; below 99% it needs\nmanual approval.\n\nPros:\n\u2022 a published, human-made bar to measure against\n\u2022 unsure verdicts wait for a person\n\u2022 the 99% line is set on real labels\n\nCons:\n\u2022 results documents must be fetched as they were\n\u2022 47 incomplete documents is a small test set",
   "originalText": "A. Match the reviewers, then publish at \u2265 99% confidence\n(chosen)\n\nHow it works: run the workflow on the 2025-11-10 snapshot\nuntil every disagreement with the reviewers is explained. Each\nverdict carries an internal confidence; below 99% it needs\nmanual approval.\n\nPros:\n\u2022 a published, human-made bar to measure against\n\u2022 unsure verdicts wait for a person\n\u2022 the 99% line is set on real labels\n\nCons:\n\u2022 results documents must be fetched as they were\n\u2022 47 incomplete documents is a small test set",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optA",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "adr-optB",
   "type": "rectangle",
   "x": 550,
   "y": 448,
   "width": 480,
   "height": 336.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 886482157,
   "version": 1,
   "versionNonce": 639191218,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "adr-optB-text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "adr-optB-text",
   "type": "text",
   "x": 555,
   "y": 453,
   "width": 437,
   "height": 220.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 732120944,
   "version": 1,
   "versionNonce": 534263595,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B. A person approves every verdict\n\nHow it works: nothing is published until someone has approved\nit, whatever the confidence.\n\nPros:\n\u2022 no unreviewed verdict is ever published\n\nCons:\n\u2022 review work grows with every trial\n\u2022 confidence is never put to the test",
   "originalText": "B. A person approves every verdict\n\nHow it works: nothing is published until someone has approved it, whatever the confidence.\n\nPros:\n\u2022 no unreviewed verdict is ever published\n\nCons:\n\u2022 review work grows with every trial\n\u2022 confidence is never put to the test",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optB",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "adr-optC",
   "type": "rectangle",
   "x": 1060,
   "y": 448,
   "width": 480,
   "height": 336.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 986353529,
   "version": 1,
   "versionNonce": 2047429391,
   "isDeleted": false,
   "boundElements": [
