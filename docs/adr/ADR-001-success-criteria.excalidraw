   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Verdicts at 99% or above match the reviewers or manual approvals less than 99% of the time. Or\na published verdict turns out wrong. Or a second labelled dataset disagrees with Bruckner's\nreviewers. Or the publication policy (S13) changes who approves what.",
   "originalText": "Verdicts at 99% or above match the reviewers or manual approvals less than 99% of the time. Or a published verdict turns out wrong. Or a second labelled dataset disagrees with Bruckner's reviewers. Or the publication policy (S13) changes who approves what.",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-revisit",
   "lineHeight": 1.25,
   "autoResize": true
  },
