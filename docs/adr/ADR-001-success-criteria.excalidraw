    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "adr-optC-text",
   "type": "text",
   "x": 1065,
   "y": 453,
   "width": 413,
   "height": 220.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1857874643,
   "version": 1,
   "versionNonce": 877175057,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "C. One threshold, no manual approval\n\nHow it works: publish verdicts at or above a threshold; drop\neverything below it.\n\nPros:\n\u2022 no review work at all\n\nCons:\n\u2022 borderline cases vanish silently\n\u2022 one wrong threshold puts errors in public",
   "originalText": "C. One threshold, no manual approval\n\nHow it works: publish verdicts at or above a threshold; drop everything below it.\n\nPros:\n\u2022 no review work at all\n\nCons:\n\u2022 borderline cases vanish silently\n\u2022 one wrong threshold puts errors in public",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optC",
   "lineHeight": 1.25,
   "autoResize": true
  },
