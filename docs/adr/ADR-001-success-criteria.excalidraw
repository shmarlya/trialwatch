   "versionNonce": 1740879401,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The reviewers first agreed on 79% of documents, so 100% raw agreement isn't expected; the 43 they argued about are good tests for low confidence. Rule of three: showing \u2264 1% error takes about\n300 correct high-confidence verdicts in a row, more than Bruckner's set, so manual approvals keep adding labels until then. How the confidence is produced is decided in S5 and S7.",
   "originalText": "The reviewers first agreed on 79% of documents, so 100% raw agreement isn't expected; the 43 they argued about are good tests for low confidence. Rule of three: showing \u2264 1% error takes about 300 correct high-confidence verdicts in a row, more than Bruckner's set, so manual approvals keep adding labels until then. How the confidence is produced is decided in S5 and S7.",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-notes",
   "lineHeight": 1.25,
   "autoResize": true
  },
