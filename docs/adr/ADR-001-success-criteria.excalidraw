   "link": null,
   "locked": false
  },
  {
   "id": "adr-easier-text",
   "type": "text",
   "x": 45,
   "y": 1454.5,
   "width": 679,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1993307798,
   "version": 1,
   "versionNonce": 584305850,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "We measure progress against one published, human-made answer key. Moving the publish line is\na config change. Review time goes only to verdicts under 99%. Any verdict can be explained from\nits own record.",
   "originalText": "We measure progress against one published, human-made answer key. Moving the publish line is a config change. Review time goes only to verdicts under 99%. Any verdict can be explained from its own record.",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-easier",
   "lineHeight": 1.25,
   "autoResize": true
  },
