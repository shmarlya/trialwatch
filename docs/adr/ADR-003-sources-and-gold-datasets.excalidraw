  {
   "id": "adr-question-text",
   "type": "text",
   "x": 46,
   "y": 162,
   "width": 1488,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
