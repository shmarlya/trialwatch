   "locked": false
  },
  {
   "id": "adr-context-text",
   "type": "text",
   "x": 46,
   "y": 281.0,
   "width": 1488,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1446394700,
   "version": 1,
   "versionNonce": 123095346,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022 Everything is CTIS-shaped today: ctis.* tables, CTIS document types, CTIS snapshots. A trial from ClinicalTrials.gov, a journal publication or a document added by\n   hand has nowhere to go.\n\u2022 Checks read only the CTIS summary of results, but a trial's results can be in any document linked to it.\n\u2022 Bruckner et al.'s labels sit in the working database (gold.bruckner_*) and the workflow selects trials with --reviewed. They are our benchmark, to be used only in\n   tests, CI and after changes to retrieval, prompts, model settings or code, and the benchmark itself may grow or be replaced.\n\u2022 The same PDF is already stored under several documents (e.g. a lay summary and a summary of results with the same bytes); the same trial may come from several\n   registries.\n\u2022 Nobody can tell who added a trial, a document or a link, or when. Judgements by a person (ADR-001: undecided goes to a person) have no home.\n\u2022 Comparing our check with reviewers who read different documents produces false 'false accusations', the costliest error (ADR-001).",
   "originalText": "\u2022 Everything is CTIS-shaped today: ctis.* tables, CTIS document types, CTIS snapshots. A trial from ClinicalTrials.gov, a journal publication or a document added by\n   hand has nowhere to go.\n\u2022 Checks read only the CTIS summary of results, but a trial's results can be in any document linked to it.\n\u2022 Bruckner et al.'s labels sit in the working database (gold.bruckner_*) and the workflow selects trials with --reviewed. They are our benchmark, to be used only in\n   tests, CI and after changes to retrieval, prompts, model settings or code, and the benchmark itself may grow or be replaced.\n\u2022 The same PDF is already stored under several documents (e.g. a lay summary and a summary of results with the same bytes); the same trial may come from several\n   registries.\n\u2022 Nobody can tell who added a trial, a document or a link, or when. Judgements by a person (ADR-001: undecided goes to a person) have no home.\n\u2022 Comparing our check with reviewers who read different documents produces false 'false accusations', the costliest error (ADR-001).",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-context",
   "lineHeight": 1.25,
   "autoResize": true
  },
