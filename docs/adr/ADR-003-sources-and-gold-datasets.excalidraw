   "autoResize": true
  },
  {
   "id": "adr-context",
   "type": "rectangle",
   "x": 40,
   "y": 275.0,
   "width": 1500,
   "height": 194.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "#ffffff",
