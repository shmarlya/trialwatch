   "updated": 1,
   "link": null,
   "locked": false,
   "text": "what forces this decision now: facts and constraints, no solutions",
   "originalText": "what forces this decision now: facts and constraints, no solutions",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
