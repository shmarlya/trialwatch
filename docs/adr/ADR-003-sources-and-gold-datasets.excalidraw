  {
   "id": "adr-notes-text",
   "type": "text",
   "x": 46,
   "y": 2027.0,
   "width": 1488,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
