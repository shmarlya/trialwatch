   "versionNonce": 1873300939,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How do we store trials, documents and gold labels so that sources can change, nothing is stored twice, every change is traceable, and a check can\nbe evaluated against any gold dataset?",
   "originalText": "How do we store trials, documents and gold labels so that sources can change, nothing is stored twice, every change is traceable, and a check can\nbe evaluated against any gold dataset?",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-question",
   "lineHeight": 1.25,
   "autoResize": true
  },
