   "locked": false
  },
  {
   "id": "adr-optC-text",
   "type": "text",
   "x": 1066,
   "y": 535.0,
   "width": 468,
   "height": 280.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1762920127,
   "version": 1,
   "versionNonce": 647532368,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "C. Generic JSON store\n\nHow it works: one table of JSON documents keyed by\n(source, key, kind); views and code interpret them.\n\nPros:\n\u2022 any source fits without migrations\n\u2022 quick to start\n\nCons:\n\u2022 no constraints: duplicates and broken links are\n   allowed\n\u2022 queries and checks parse JSON everywhere\n\u2022 the audit and versioning rules live only in code",
   "originalText": "C. Generic JSON store\n\nHow it works: one table of JSON documents keyed by\n(source, key, kind); views and code interpret them.\n\nPros:\n\u2022 any source fits without migrations\n\u2022 quick to start\n\nCons:\n\u2022 no constraints: duplicates and broken links are\n   allowed\n\u2022 queries and checks parse JSON everywhere\n\u2022 the audit and versioning rules live only in code",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optC",
   "lineHeight": 1.25,
   "autoResize": true
  },
