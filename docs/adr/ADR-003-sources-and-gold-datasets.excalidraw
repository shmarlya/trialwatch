   "seed": 847541672,
   "version": 1,
   "versionNonce": 524935313,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Decided with the user on 2026-11-18: back up the local database (pg_dump) and start from scratch; gold data only in evaluation databases; manual check = a person's\njudgement and starting an automatic check by hand; every automatic check keeps a step-by-step trace for the web interface. Rejected: merging duplicate trials\nautomatically when identifiers conflict (a wrong merge mixes two trials' results).",
   "originalText": "Decided with the user on 2026-11-18: back up the local database (pg_dump) and start from scratch; gold data only in evaluation databases; manual check = a person's\njudgement and starting an automatic check by hand; every automatic check keeps a step-by-step trace for the web interface. Rejected: merging duplicate trials\nautomatically when identifiers conflict (a wrong merge mixes two trials' results).",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-notes",
   "lineHeight": 1.25,
   "autoResize": true
  },
