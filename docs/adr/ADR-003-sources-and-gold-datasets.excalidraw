   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How to use: copy to docs/adr/ADR-NNN-name.excalidraw \u00b7 replace the grey text (set it to black) \u00b7 status chip colour: orange open, yellow proposed, green accepted, grey\nsuperseded \u00b7 one page: if it doesn't fit, the decision is too big, so split it.",
   "originalText": "How to use: copy to docs/adr/ADR-NNN-name.excalidraw \u00b7 replace the grey text (set it to black) \u00b7 status chip colour: orange open, yellow proposed, green accepted, grey\nsuperseded \u00b7 one page: if it doesn't fit, the decision is too big, so split it.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
