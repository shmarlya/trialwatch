  {
   "id": "adr-optC-text",
   "type": "text",
   "x": 1066,
   "y": 495.0,
   "width": 468,
   "height": 240.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1772939540,
   "version": 1,
   "versionNonce": 870463669,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "C. Requirements in the database\n\nHow it works: tables of requirements edited in the\nweb interface.\n\nPros:\n\u2022 editable without a deploy\n\nCons:\n\u2022 changes bypass code review and CI\n\u2022 harder to keep in step with the code and tests\n\u2022 another editor to build",
   "originalText": "C. Requirements in the database\n\nHow it works: tables of requirements edited in the\nweb interface.\n\nPros:\n\u2022 editable without a deploy\n\nCons:\n\u2022 changes bypass code review and CI\n\u2022 harder to keep in step with the code and tests\n\u2022 another editor to build",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optC",
   "lineHeight": 1.25,
   "autoResize": true
  },
