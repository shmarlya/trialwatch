   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How does the check decide what a trial must report and whether it is enough, without naming a registry, a document type or a regulation in its code\nor prompt?",
   "originalText": "How does the check decide what a trial must report and whether it is enough, without naming a registry, a document type or a regulation in its code\nor prompt?",
   "fontSize": 18,
   "fontFamily": 6,
