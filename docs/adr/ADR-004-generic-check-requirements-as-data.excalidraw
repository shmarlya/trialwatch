   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Harder: a standard whose rule doesn't fit the vocabulary needs a new rule type\nin code; until production, a changed file changes what the next run does (the\nruns before keep their own copy).",
   "originalText": "Harder: a standard whose rule doesn't fit the vocabulary needs a new rule type\nin code; until production, a changed file changes what the next run does (the\nruns before keep their own copy).",
