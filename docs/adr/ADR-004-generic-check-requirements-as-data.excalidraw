  {
   "id": "h-options-hint",
   "type": "text",
   "x": 144.24,
   "y": 460.0,
   "width": 491.20000000000005,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
