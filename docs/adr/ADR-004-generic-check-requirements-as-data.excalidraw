   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Easier: a new standard or document type is a file; reading what decided a label\n(set, rule, quote, page); comparing runs that used different sets; a prompt free\nof any source.",
   "originalText": "Easier: a new standard or document type is a file; reading what decided a label\n(set, rule, quote, page); comparing runs that used different sets; a prompt free\nof any source.",
