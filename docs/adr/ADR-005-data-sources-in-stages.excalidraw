  {
   "id": "adr-decision",
   "type": "rectangle",
   "x": 40,
   "y": 1329.0,
   "width": 1500,
   "height": 274.0,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "#d3f9d8",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 710626283,
   "version": 1,
   "versionNonce": 1445641265,
   "isDeleted": false,
   "boundElements": [
