   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Easier: choosing trials from the whole registry; a new registry is one adapter\nclass; seeing per trial what is missing or stale; trusting that a checked trial\nhad all its evidence.",
   "originalText": "Easier: choosing trials from the whole registry; a new registry is one adapter\nclass; seeing per trial what is missing or stale; trusting that a checked trial\nhad all its evidence.",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-easier",
   "lineHeight": 1.25,
   "autoResize": true
  },
