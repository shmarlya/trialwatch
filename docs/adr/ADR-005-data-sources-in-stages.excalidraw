  {
   "id": "adr-easier-text",
   "type": "text",
   "x": 46,
   "y": 1669.0,
   "width": 723,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
