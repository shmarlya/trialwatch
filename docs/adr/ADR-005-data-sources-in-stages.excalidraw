  {
   "id": "adr-context-text",
   "type": "text",
   "x": 46,
   "y": 281.0,
   "width": 1488,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
