   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How do trials get from a registry into TrialWatch so that a person chooses what to read, every source works the same way, and a check never runs on\nevidence that only partly arrived?",
   "originalText": "How do trials get from a registry into TrialWatch so that a person chooses what to read, every source works the same way, and a check never runs on\nevidence that only partly arrived?",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-question",
   "lineHeight": 1.25,
   "autoResize": true
  },
