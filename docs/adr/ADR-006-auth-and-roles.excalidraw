  {
   "id": "adr-optC-text",
   "type": "text",
   "x": 1066,
   "y": 491.0,
   "width": 468,
   "height": 220.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
