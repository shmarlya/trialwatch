   "version": 1,
   "versionNonce": 571317948,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "C. The chart as data\n\nHow it works: roles and role_action tables, edited\non an admin page.\n\n+ rules change without a deploy\n– more tables and pages to build\n– a wrong row opens an action silently; tests can't\n  see it\n– rule changes need versioning (none before\n  production)",
   "originalText": "C. The chart as data\n\nHow it works: roles and role_action tables, edited\non an admin page.\n\n+ rules change without a deploy\n– more tables and pages to build\n– a wrong row opens an action silently; tests can't\n  see it\n– rule changes need versioning (none before\n  production)",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optC",
   "lineHeight": 1.25,
   "autoResize": true
  },
