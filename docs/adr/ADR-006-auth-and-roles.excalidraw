   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Easier: a new role or action is one line in the chart, and /admin/roles and\nthe tests follow; the audit log names the person who acted.",
   "originalText": "Easier: a new role or action is one line in the chart, and /admin/roles and\nthe tests follow; the audit log names the person who acted.",
   "fontSize": 16,
   "fontFamily": 6,
