  {
   "id": "h-decision-hint",
   "type": "text",
   "x": 156.56,
   "y": 1130.0,
   "width": 365.20000000000005,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 539940357,
   "version": 1,
   "versionNonce": 952183056,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "what we chose and which criteria decided it",
   "originalText": "what we chose and which criteria decided it",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "adr-decision",
   "type": "rectangle",
   "x": 40,
   "y": 1159.0,
   "width": 1500,
   "height": 132.0,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "#d3f9d8",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 893153101,
   "version": 1,
   "versionNonce": 737753962,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "adr-decision-text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "adr-decision-text",
   "type": "text",
   "x": 46,
   "y": 1165.0,
   "width": 1488,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1216386184,
   "version": 1,
   "versionNonce": 402075856,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "We choose B. Anyone may browse (view); every other action needs a signed-in user whose role the chart allows. Admins may do everything. Moderators\ncurate: add trials, upload documents, edit sponsors, transfer evidence, run dry-run checks and stop their own jobs. Only admins sync and configure\nsources, run checks that call the model (they cost money), stop other people's jobs and manage users. Sign-in is a username and password (argon2id) in\nauth.app_user; a session is a random token in an HttpOnly, SameSite=Lax cookie, kept in auth.session only as its SHA-256, ending after 12 hours idle\nor 7 days. There is no sign-up: the first admin is added with `trialwatch user add`. No API tokens yet: the same routes answer a script with 401 or\n403. The command line is not limited by roles, since whoever runs it holds the database password. Decided by: safety and clarity.",
   "originalText": "We choose B. Anyone may browse (view); every other action needs a signed-in user whose role the chart allows. Admins may do everything. Moderators\ncurate: add trials, upload documents, edit sponsors, transfer evidence, run dry-run checks and stop their own jobs. Only admins sync and configure\nsources, run checks that call the model (they cost money), stop other people's jobs and manage users. Sign-in is a username and password (argon2id) in\nauth.app_user; a session is a random token in an HttpOnly, SameSite=Lax cookie, kept in auth.session only as its SHA-256, ending after 12 hours idle\nor 7 days. There is no sign-up: the first admin is added with `trialwatch user add`. No API tokens yet: the same routes answer a script with 401 or\n403. The command line is not limited by roles, since whoever runs it holds the database password. Decided by: safety and clarity.",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-decision",
   "lineHeight": 1.25,
   "autoResize": true
  },
