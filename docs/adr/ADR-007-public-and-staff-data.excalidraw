  {
   "id": "adr-context-text",
   "type": "text",
   "x": 46,
   "y": 279.0,
   "width": 1488,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
