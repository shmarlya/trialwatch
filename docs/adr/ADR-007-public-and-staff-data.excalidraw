  {
   "id": "h-decision-hint",
   "type": "text",
   "x": 156.56,
   "y": 1214.0,
   "width": 365.20000000000005,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
