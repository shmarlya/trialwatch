   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1725363131,
   "version": 1,
   "versionNonce": 1809724607,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
