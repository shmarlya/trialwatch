   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Easier: no review queue; everything we decide is public with its\nmethod, and a withdrawal can't hide a result.",
   "originalText": "Easier: no review queue; everything we decide is public with its\nmethod, and a withdrawal can't hide a result.",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-easier",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
