  },
  {
   "id": "adr-optA-text",
   "type": "text",
   "x": 46,
   "y": 531.0,
   "width": 468,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1898149269,
   "version": 2,
   "versionNonce": 64456777,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A. Send people to CTIS's own search\n\nHow it works: a link to euclinicaltrials.eu with\nthe words filled in.\n\n+ nothing to build\n– no synonyms or distance; what we read is unused",
   "originalText": "A. Send people to CTIS's own search\n\nHow it works: a link to euclinicaltrials.eu with\nthe words filled in.\n\n+ nothing to build\n– no synonyms or distance; what we read is unused",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optA",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "adr-optB",
   "type": "rectangle",
   "x": 550,
   "y": 525.0,
   "width": 480,
   "height": 332.0,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1774749034,
   "version": 1,
   "versionNonce": 139355851,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "adr-optB-text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "adr-optB-text",
   "type": "text",
   "x": 556,
   "y": 531.0,
   "width": 468,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 287393588,
   "version": 2,
   "versionNonce": 1720317126,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B. Own index: rules, a gazetteer, AI tags offline\n\nHow it works: each transfer reads a profile from\nthe record and builds a search document:\nconditions, translations, MedDRA and MeSH\nconcepts with the tree above them, categories;\nsites get points from GeoNames. Rules read a\nquery and show their reading. A model tags each\nrecruiting trial once, every tag with a quote\nchecked against its field.\n\n+ instant, free per search, the same every time\n+ nothing about a search leaves the server\n– rules miss sentences (“my son has CF near Lyon”)\n– GeoNames and MeSH to load and keep current",
   "originalText": "B. Own index: rules, a gazetteer, AI tags offline\n\nHow it works: each transfer reads a profile from\nthe record and builds a search document:\nconditions, translations, MedDRA and MeSH\nconcepts with the tree above them, categories;\nsites get points from GeoNames. Rules read a\nquery and show their reading. A model tags each\nrecruiting trial once, every tag with a quote\nchecked against its field.\n\n+ instant, free per search, the same every time\n+ nothing about a search leaves the server\n– rules miss sentences (“my son has CF near Lyon”)\n– GeoNames and MeSH to load and keep current",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optB",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "adr-optC",
   "type": "rectangle",
