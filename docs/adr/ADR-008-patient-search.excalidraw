   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How does a person find a trial they could join in our data (“diabetes Paris”), among only the trials that recruit now, and what must the data and the\npublic pages gain for it?",
   "originalText": "How does a person find a trial they could join in our data (“diabetes Paris”), among only the trials that recruit now, and what must the data and the\npublic pages gain for it?",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-question",
   "lineHeight": 1.25,
   "autoResize": true
  },
