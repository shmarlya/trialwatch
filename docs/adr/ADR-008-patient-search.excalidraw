  {
   "id": "adr-optC-text",
   "type": "text",
   "x": 1066,
   "y": 531.0,
   "width": 468,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 491633472,
   "version": 2,
   "versionNonce": 1740412910,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "C. A model reads every query\n\nHow it works: each search asks a model for filters.\n\n+ understands sentences\n– cost and delay on every search; abuse\n– health questions sent out with every search",
   "originalText": "C. A model reads every query\n\nHow it works: each search asks a model for filters.\n\n+ understands sentences\n– cost and delay on every search; abuse\n– health questions sent out with every search",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-optC",
   "lineHeight": 1.25,
   "autoResize": true
  },
