   "versionNonce": 2105725222,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "what we chose and which criteria decided it",
   "originalText": "what we chose and which criteria decided it",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "adr-decision",
   "type": "rectangle",
   "x": 40,
   "y": 1243.0,
   "width": 1500,
   "height": 172.0,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "#d3f9d8",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 744069012,
   "version": 1,
   "versionNonce": 76363646,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "adr-decision-text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "adr-decision-text",
   "type": "text",
   "x": 46,
   "y": 1249.0,
   "width": 1488,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1115423877,
   "version": 2,
   "versionNonce": 1828766281,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "We choose B. Every trial's full record is synced, recruiting ones first; a transfer stores the trial's profile (core.trial_profile) and builds its search\ndocument (search.document) at once, so a trial is findable as it arrives. A query is read by rules and GeoNames, never a model; the page shows the\nreading (“diabetes · near Paris, France · within 50 km”) and lets the reader change it. Conditions match by word beginnings (accents aside), CTIS's\ntranslations, MedDRA names, MeSH concepts and the tree above them, and AI synonyms once tagged; exclusion criteria never. AI tags: one model call\nper recruiting trial, each tag kept only if its quote is in its field. Amends ADR-007: the page of a trial that recruits now is public, judged or not\n(view.recruiting). Searches are private: never stored, no referrer, not cached or indexed, no query string in the access log. Decided by quality and\nprivacy at no cost per search.",
   "originalText": "We choose B. Every trial's full record is synced, recruiting ones first; a transfer stores the trial's profile (core.trial_profile) and builds its search\ndocument (search.document) at once, so a trial is findable as it arrives. A query is read by rules and GeoNames, never a model; the page shows the\nreading (“diabetes · near Paris, France · within 50 km”) and lets the reader change it. Conditions match by word beginnings (accents aside), CTIS's\ntranslations, MedDRA names, MeSH concepts and the tree above them, and AI synonyms once tagged; exclusion criteria never. AI tags: one model call\nper recruiting trial, each tag kept only if its quote is in its field. Amends ADR-007: the page of a trial that recruits now is public, judged or not\n(view.recruiting). Searches are private: never stored, no referrer, not cached or indexed, no query string in the access log. Decided by quality and\nprivacy at no cost per search.",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "adr-decision",
   "lineHeight": 1.25,
   "autoResize": true
  },
