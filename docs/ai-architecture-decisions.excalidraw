   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Prompt injection = instructions hidden in\ninput data. Indirect injection = it arrives\ninside a document or tool result. Least\nprivilege = only the tools and data a step\nneeds. Model output = untrusted input to your\ncode.",
   "originalText": "Prompt injection = instructions hidden in\ninput data. Indirect injection = it arrives\ninside a document or tool result. Least\nprivilege = only the tools and data a step\nneeds. Model output = untrusted input to your\ncode.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
