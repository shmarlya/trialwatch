   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CLAUDE.md = instructions loaded every session\n(user, project, folder). Skill = packaged\ninstructions loaded when relevant. Hook = a\ncommand run on an event, e.g. after each\nedit. Plan mode = plan before editing. claude\n-p = headless, for CI.",
   "originalText": "CLAUDE.md = instructions loaded every session\n(user, project, folder). Skill = packaged\ninstructions loaded when relevant. Hook = a\ncommand run on an event, e.g. after each\nedit. Plan mode = plan before editing. claude\n-p = headless, for CI.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
