   "versionNonce": 1086790044,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Agentic loop = call model \u2192 run requested\ntools \u2192 return results \u2192 repeat while\nstop_reason is \"tool_use\". Subagent = fresh\ncontext for a subtask, returns a summary.\nHook = code run before or after a tool call.",
   "originalText": "Agentic loop = call model \u2192 run requested\ntools \u2192 return results \u2192 repeat while\nstop_reason is \"tool_use\". Subagent = fresh\ncontext for a subtask, returns a summary.\nHook = code run before or after a tool call.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
