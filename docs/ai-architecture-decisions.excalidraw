   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Nondeterminism = same input, different\noutput; design for it, don't count on\ntemperature 0. Hallucination = fluent,\nunsupported claim. Transient errors (429,\n529, 5xx) vs permanent (400). Escalation =\nhand to a person or a stronger model.",
   "originalText": "Nondeterminism = same input, different\noutput; design for it, don't count on\ntemperature 0. Hallucination = fluent,\nunsupported claim. Transient errors (429,\n529, 5xx) vs permanent (400). Escalation =\nhand to a person or a stronger model.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
