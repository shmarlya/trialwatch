   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Context = everything the model sees on one\ncall. Context rot = answers get worse as the\nwindow fills. Prompt caching = re-send a\nfixed prefix at ~10% of the input price.\nCompaction = summarise old turns.",
   "originalText": "Context = everything the model sees on one\ncall. Context rot = answers get worse as the\nwindow fills. Prompt caching = re-send a\nfixed prefix at ~10% of the input price.\nCompaction = summarise old turns.",
