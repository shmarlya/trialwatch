   "updated": 1763726400000,
   "link": null,
   "locked": false,
   "text": "PK trial_id, source_id   FK → trial, source\nFK trial_record_id → trial_record   read from\n   profile      jsonb: conditions + translations,\n                MedDRA terms, MeSH areas, phase,\n                ages, sex, healthy volunteers,\n                criteria, products, countries\n   profile_hash   sha256: unchanged = no rebuild\n   recruiting   recruits now somewhere\n   read_at, created_by   (audited, not profile)\nno people; not part of `registered`",
   "originalText": "PK trial_id, source_id   FK → trial, source\nFK trial_record_id → trial_record   read from\n   profile      jsonb: conditions + translations,\n                MedDRA terms, MeSH areas, phase,\n                ages, sex, healthy volunteers,\n                criteria, products, countries\n   profile_hash   sha256: unchanged = no rebuild\n   recruiting   recruits now somewhere\n   read_at, created_by   (audited, not profile)\nno people; not part of `registered`",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
