   "isDeleted": false,
   "boundElements": [],
   "updated": 1763726400000,
   "link": null,
   "locked": false,
   "text": "PK id\n   email          unique, lower case;\n                  signs in with it\n   password_hash  argon2id (left out of the\n                  audit log)\n   role           admin | moderator\nFK actor_id → core.actor   writes as them\n   disabled_at    can't sign in when set\n   created_at",
   "originalText": "PK id\n   email          unique, lower case;\n                  signs in with it\n   password_hash  argon2id (left out of the\n                  audit log)\n   role           admin | moderator\nFK actor_id → core.actor   writes as them\n   disabled_at    can't sign in when set\n   created_at",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
