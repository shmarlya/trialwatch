  {
   "id": "auth_app_user_b",
   "type": "text",
   "x": 52,
   "y": 2190,
   "width": 361.2,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
