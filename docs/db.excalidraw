   "boundElements": [],
   "updated": 1763726400000,
   "link": null,
   "locked": false,
   "text": "PK id\nFK run_id, trial_id → checks.judgement\nFK published_by → core.actor (trialwatch)\n   published_at\n   withdrawn_by, withdrawn_at   set together;\n                 withdrawn stays public, marked\n   note          why withdrawn (shown to all)\n   confidence    gold agreement of its kind,\n                 once measured; else NULL\n   basis         how its kind compared with gold\none live publication per judgement; only a\nfinished judgement without an error (trigger)",
   "originalText": "PK id\nFK run_id, trial_id → checks.judgement\nFK published_by → core.actor (trialwatch)\n   published_at\n   withdrawn_by, withdrawn_at   set together;\n                 withdrawn stays public, marked\n   note          why withdrawn (shown to all)\n   confidence    gold agreement of its kind,\n                 once measured; else NULL\n   basis         how its kind compared with gold\none live publication per judgement; only a\nfinished judgement without an error (trigger)",
   "fontSize": 14,
   "fontFamily": 3,
