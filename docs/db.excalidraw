  {
   "id": "subtitle",
   "type": "text",
   "x": 22,
   "y": -16,
   "width": 1971.2000000000003,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
