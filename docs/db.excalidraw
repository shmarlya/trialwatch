  },
  {
   "id": "core_source_listing_b",
   "type": "text",
   "x": 1932,
   "y": 671.5,
   "width": 403.2,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
