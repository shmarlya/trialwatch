   "version": 4,
   "versionNonce": 847122727,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1763726400000,
   "link": null,
   "locked": false,
   "text": "PK id\n   kind        sync | transfer | check | annotate |\n               refresh\n   params      jsonb: source, keys, trial_ids, config\n   automatic   started by TrialWatch (cap applies)\nFK parent_id → jobs.job   a refresh's stages\nFK schedule_id → jobs.schedule\n   priority    lower runs first\n   status      queued | running | waiting | held |\n               succeeded | failed | cancelled\n   attempts, max_attempts, run_after   retries\n   cancel_requested, last_error, result jsonb\n   locked_by, heartbeat_at   the worker on it\nFK created_by → core.actor\n   created_at, started_at, finished_at",
   "originalText": "PK id\n   kind        sync | transfer | check | annotate |\n               refresh\n   params      jsonb: source, keys, trial_ids, config\n   automatic   started by TrialWatch (cap applies)\nFK parent_id → jobs.job   a refresh's stages\nFK schedule_id → jobs.schedule\n   priority    lower runs first\n   status      queued | running | waiting | held |\n               succeeded | failed | cancelled\n   attempts, max_attempts, run_after   retries\n   cancel_requested, last_error, result jsonb\n   locked_by, heartbeat_at   the worker on it\nFK created_by → core.actor\n   created_at, started_at, finished_at",
   "fontSize": 14,
   "fontFamily": 3,
