   "boundElements": [],
   "updated": 1763726400000,
   "link": null,
   "locked": false,
   "text": "PK source_id, source_key  FK → trial_source\n   title, source_updated_on   as listed\n   summary         jsonb: the list's row\n   first_listed_at, last_listed_at\nFK last_run → ingest_run   (kind list)\n   delisted_at     set when two complete syncs\n                   in a row missed it (kept)\n   recruiting      the list says it recruits now",
   "originalText": "PK source_id, source_key  FK → trial_source\n   title, source_updated_on   as listed\n   summary         jsonb: the list's row\n   first_listed_at, last_listed_at\nFK last_run → ingest_run   (kind list)\n   delisted_at     set when two complete syncs\n                   in a row missed it (kept)\n   recruiting      the list says it recruits now",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
