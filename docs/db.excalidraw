  {
   "id": "jobs_job_b",
   "type": "text",
   "x": 52,
   "y": 2560,
   "width": 445.2,
   "height": 262.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
