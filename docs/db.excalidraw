   "boundElements": [],
   "updated": 1763726400000,
   "link": null,
   "locked": false,
   "text": "PK id\nFK trial_id → trial, source_id → source\n   country        NOT NULL\n   city, postcode, site   NULL: no site\n   status         the trial's status there\n   created_at, created_by\n   country_key, postcode_key, city_key   generated:\n                  → geo.address_point (its point)\nno people (investigators, emails, phones)",
   "originalText": "PK id\nFK trial_id → trial, source_id → source\n   country        NOT NULL\n   city, postcode, site   NULL: no site\n   status         the trial's status there\n   created_at, created_by\n   country_key, postcode_key, city_key   generated:\n                  → geo.address_point (its point)\nno people (investigators, emails, phones)",
   "fontSize": 14,
   "fontFamily": 3,
