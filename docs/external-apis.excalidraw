   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "search_req_b",
   "type": "text",
   "x": 32,
   "y": 100,
   "width": 566.02,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 949356030,
   "version": 2,
   "versionNonce": 1131287583,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1763726400000,
   "link": null,
   "locked": false,
   "text": "  pagination.page               int   page number, starts at 1\n  pagination.size               int   rows per page (500 at most)\n* sort.property                 str   we send ctNumber: stable paging\n* sort.direction                str   ASC, then DESC (see below)\n* searchCriteria                obj   the config's listing.criteria,\n                                      + containAll/Any/Not, empty\nAt most 10,000 rows per query (seen 2026-11-21): a longer list\nis read ascending, then descending down to the trials the\nascending pass read. A trial seen twice in one pass is skipped.",
   "originalText": "  pagination.page               int   page number, starts at 1\n  pagination.size               int   rows per page (500 at most)\n* sort.property                 str   we send ctNumber: stable paging\n* sort.direction                str   ASC, then DESC (see below)\n* searchCriteria                obj   the config's listing.criteria,\n                                      + containAll/Any/Not, empty\nAt most 10,000 rows per query (seen 2026-11-21): a longer list\nis read ascending, then descending down to the trials the\nascending pass read. A trial seen twice in one pass is skipped.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
