   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Step 1: CTIS answers with JSON\n* url                           str   presigned S3 link, valid ~5 min\n\nStep 2: GET that url\n  (body)                        PDF   the file itself, e.g. type 103\n\nFetch step 2 right away: the link expires.",
   "originalText": "Step 1: CTIS answers with JSON\n* url                           str   presigned S3 link, valid ~5 min\n\nStep 2: GET that url\n  (body)                        PDF   the file itself, e.g. type 103\n\nFetch step 2 right away: the link expires.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
