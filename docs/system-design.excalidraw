   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "schema ctis\n\nfetch_run \u2014 one row per run\n   (kind, status, counts, error)\ntrial \u2014 one row per CT number\ntrial_snapshot \u2014 raw JSON (lz4)\n   new row only when content changes\nview trial_latest \u2014 newest per trial\nsearch_export_snapshot \u2014 CSV rows\n   as in the file (e.g. 2025-11-10)",
   "originalText": "schema ctis\n\nfetch_run \u2014 one row per run\n   (kind, status, counts, error)\ntrial \u2014 one row per CT number\ntrial_snapshot \u2014 raw JSON (lz4)\n   new row only when content changes\nview trial_latest \u2014 newest per trial\nsearch_export_snapshot \u2014 CSV rows\n   as in the file (e.g. 2025-11-10)",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
