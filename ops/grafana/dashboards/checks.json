{
  "uid": "trialwatch-checks",
  "title": "TrialWatch · Checks",
  "description": "Evidence checks: what they decided, how often they failed, their agreement with gold labels",
  "tags": [
    "trialwatch"
  ],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "timeseries",
      "title": "Judgements per day by label",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trialwatch-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trialwatch-db"
          },
          "rawSql": "SELECT $__timeGroupAlias(at, '1d'), coalesce(label, 'error') AS metric, count(*) AS judgements FROM report.judgements WHERE $__timeFilter(at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Measured agreement with gold labels",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trialwatch-db"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trialwatch-db"
          },
          "rawSql": "SELECT $__timeGroupAlias(at, '1d'), avg(confidence) AS agreement FROM report.judgements WHERE $__timeFilter(at) AND confidence IS NOT NULL GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "The confidence published with each judgement: how often judgements of its kind agreed with gold labels.",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Model calls by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (operation, outcome) (increase(trialwatch_llm_calls_total[1h]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Model call latency (95th percentile)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(trialwatch_llm_duration_seconds_bucket[15m])))",
          "legendFormat": "{{model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Check runs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trialwatch-db"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trialwatch-db"
          },
          "rawSql": "SELECT id AS run, started_at, finished_at, status, model, requirements, trials, errors, cost_usd FROM report.check_runs ORDER BY id DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 5
    }
  ]
}
